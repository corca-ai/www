---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  isAxPage?: boolean;
}

const { lang, isAxPage = false } = Astro.props;
const publisherName = { ko: '코르카', en: 'Corca', ja: 'コルカ', zh: 'Corca' }[lang];
const axMobileFontUrl = {
  ko: '/fonts/ax-mobile/v1/pretendard-ko.woff2',
  en: '/fonts/ax-mobile/v1/pretendard-en.woff2',
  ja: '/fonts/ax-mobile/v1/pretendard-ja.woff2',
  zh: '',
}[lang];
const axMobileFontFace = axMobileFontUrl
  ? `@font-face{font-family:"Pretendard AX Mobile";font-style:normal;font-display:swap;font-weight:45 920;src:url("${axMobileFontUrl}") format("woff2-variations")}`
  : '';
---

<!-- corca-common-head:start -->
<link
  rel="shortcut icon"
  type="image/x-icon"
  href="https://www.corca.ai/favicon.ico"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="https://www.corca.ai/favicons/corca-ai-32.png"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="https://www.corca.ai/favicons/corca-ai-apple-touch-180.png"
/>
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0034ac" />
<meta name="application-name" content="Corca" />
<meta name="apple-mobile-web-app-title" content="Corca" />
<meta name="publisher" content={publisherName} />

<!-- Microsoft Clarity. AX mobile delays the network request until after load
     so session analytics cannot compete with the LCP poster. -->
<script type="text/javascript" is:inline define:vars={{ isAxPage }}>
  (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};

    const loadClarity = function(){
      if (l.querySelector('script[data-clarity-tag]')) return;
      t=l.createElement(r);t.async=1;t.dataset.clarityTag='true';
      t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    };

    const deferClarity = isAxPage && c.matchMedia('(max-width: 720px)').matches;
    if (!deferClarity) {
      loadClarity();
    } else {
      const interactionEvents = ['pointerdown', 'keydown', 'touchstart'];
      const loadOnInteraction = function(){
        interactionEvents.forEach(function(eventName){
          c.removeEventListener(eventName, loadOnInteraction);
        });
        loadClarity();
      };
      interactionEvents.forEach(function(eventName){
        c.addEventListener(eventName, loadOnInteraction, { passive: true, once: true });
      });
      c.addEventListener('load', function(){
        c.setTimeout(loadClarity, 5000);
      }, { once: true });
    }
  })(window, document, "clarity", "script", "xuw7puf7d6");
</script>

<!-- AX mobile uses one page-specific font subset instead of the dynamic
     92-slice stylesheet. Chinese keeps the native system stack because the
     bundled Pretendard families do not cover all Simplified Chinese glyphs. -->
{isAxPage && axMobileFontUrl && (
  <link
    rel="preload"
    href={axMobileFontUrl}
    as="font"
    type="font/woff2"
    crossorigin
    media="(max-width: 720px)"
  />
)}
{isAxPage && axMobileFontFace && <style is:inline set:html={axMobileFontFace} />}
<link
  rel="preload"
  href="/fonts/PretendardVariable.woff2"
  as="font"
  type="font/woff2"
  crossorigin
  media={isAxPage ? '(min-width: 721px)' : undefined}
/>
<!-- corca-common-head:end -->
