---
import { Image } from 'astro:assets';
import Breadcrumb from './Breadcrumb.astro';
import type { Crumb } from '../i18n/breadcrumbs';
import { useTranslations } from '../i18n/utils';
import { contact, type Lang } from '../i18n/ui';
import orcaFooter from '../assets/images/footer/orca-footer.png';

interface Props {
  lang: Lang;
  /** Page nodes after Home. Omitted for home. */
  breadcrumbs?: Crumb[] | undefined;
}
const { lang, breadcrumbs } = Astro.props;
const t = useTranslations(lang);
---

<footer class="corca-site-footer">
  {breadcrumbs?.length ? (
    <div class="corca-footer-breadcrumb container-c">
      <Breadcrumb lang={lang} items={breadcrumbs} />
      <img
        class="corca-footer-partner-desktop"
        src="/images/brand/openai-select-partner.svg"
        alt=""
        width="156"
        height="74"
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : null}
  <div class:list={['corca-footer-content container-c', !breadcrumbs?.length && 'corca-footer-content-home']}>
    <div class="corca-footer-copy">
      <a href={lang === 'ko' ? '/' : `/${lang}`} class="corca-footer-logo" aria-label="Corca">
        <span></span>
      </a>
      <p class="corca-footer-tagline">{t.footer.tagline.split('\n').map((line, index) => <Fragment>{index > 0 ? <br /> : null}{line}</Fragment>)}</p>
      <img
        class="corca-footer-partner-mobile"
        src="/images/brand/openai-select-partner.svg"
        alt=""
        width="156"
        height="74"
        loading="lazy"
        decoding="async"
      />
      <address class="corca-footer-legal">
        <p>{t.footer.legalName}</p>
        <p>
          {t.footer.representative}
          <span aria-hidden="true"> | </span>
          <a href="tel:+82-2-6925-6978">{t.footer.tel}</a>
          <span aria-hidden="true"> | </span>
          <a href={`mailto:${contact.email}`}>{t.footer.emailLabel} {contact.email}</a>
        </p>
        <p class="corca-footer-rights">{t.footer.rights}</p>
      </address>
    </div>
    <div class="corca-footer-visual" aria-hidden="true">
      <img
        class:list={['corca-footer-partner', breadcrumbs?.length && 'corca-footer-partner-with-breadcrumb']}
        src="/images/brand/openai-select-partner.svg"
        alt=""
        width="156"
        height="74"
        loading="lazy"
        decoding="async"
      />
      <Image
        src={orcaFooter}
        alt={t.footer.orcaAlt}
        widths={[240, 353]}
        sizes="(min-width: 900px) 353px, 80vw"
        class="corca-footer-orca"
        loading="lazy"
      />
    </div>
  </div>
</footer>
