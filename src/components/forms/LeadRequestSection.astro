---
import type { Lang } from '../../i18n/ui';
import type { LeadPageContext } from '../../lead/pageContext';
import AxLines from '../pages/ax-v2/AxLines.astro';
import { axV2ContentByLang } from '../pages/ax-v2/content';
import LeadForm from './LeadForm.astro';

interface Props {
  lang: Lang;
  pageContext?: LeadPageContext | undefined;
  heading?: string[] | undefined;
  description?: string[] | undefined;
  formId?: string | undefined;
  class?: string | undefined;
}

const {
  lang,
  pageContext,
  heading,
  description,
  formId = 'request',
  class: className,
} = Astro.props;
const contact = axV2ContentByLang[lang].contact;
const sectionHeading = heading ?? contact.heading;
const sectionDescription = description ?? contact.body;
---

<!-- corca-lead-request:start -->
<section
  class:list={['ax-v2-section', 'ax-v2-contact-section', className]}
  id="request"
  aria-labelledby={`${formId}-section-title`}
  data-contact-section
  data-lead-request-section
>
  <div class="ax-v2-shell ax-v2-contact-grid">
    <div class="ax-v2-contact-copy" data-reveal>
      <h2 id={`${formId}-section-title`}>
        {sectionHeading.map((line, index) => (
          <>
            {index > 0 && <br />}
            <span class:list={{ 'ax-v2-gradient-text': index >= Math.ceil(sectionHeading.length / 2) }}>
              {line}
            </span>
          </>
        ))}
      </h2>
      <p><AxLines values={sectionDescription} /></p>
    </div>
    <div class="ax-v2-direct-contact" data-reveal>
      <p>{contact.directLead}</p>
      <a href={`mailto:${contact.email}`}>
        {contact.emailLabel}<strong>{contact.email}</strong>
      </a>
      <a href="tel:+82269256978">
        {contact.phoneLabel}<strong>{contact.phone}</strong>
      </a>
    </div>
    <div class="ax-v2-inline-form" data-reveal>
      <LeadForm id={formId} lang={lang} compact pageContext={pageContext} />
    </div>
  </div>
</section>

<script>
  import './leadRequestSectionClient';
</script>
<!-- corca-lead-request:end -->
