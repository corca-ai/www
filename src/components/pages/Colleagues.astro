---
import type { Lang } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';
import { getTeamInterviews } from '../../teamInterviews';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const interviews = await getTeamInterviews(lang);

const heading = {
  ko: { title: '코르카 사람들', sub: '능력있고 열정적인 코르카 팀 멤버들의 경험과 성장에 대한 생생한 이야기들을 만나보세요', cover: (title: string) => `${title} 대표 이미지`, empty: '공개된 팀인터뷰가 아직 없습니다.' },
  en: { title: 'Our People', sub: 'Discover the vivid stories of experience and growth from the talented, passionate members of the Corca team.', cover: (title: string) => `Featured image for ${title}`, empty: 'There are no published team interviews yet.' },
  ja: { title: 'コルカの人々', sub: '有能で情熱的なコルカのチームメンバーたちの経験と成長に関する、生き生きとしたストーリーをご覧ください。', cover: (title: string) => `${title}の代表画像`, empty: '公開中のチームインタビューはまだありません。' },
  zh: { title: 'Corca 的伙伴们', sub: '欢迎了解Corca团队中才华横溢、充满热情的成员们关于经验与成长的生动故事。', cover: (title: string) => `${title} 的代表图片`, empty: '暂时还没有已发布的团队访谈。' },
}[lang];
---

<!-- Header band — pale-blue gradient behind the title, like corca.ai. -->
<section class="bg-gradient-to-b from-[#e1eaf7] to-white">
  <div class="container-c pb-9 pt-11 text-center md:pb-10 md:pt-16">
    <h1 class="font-body text-[21px] font-normal leading-[1.2] text-[#1a2352] md:text-[32px] lg:text-[44px] xl:text-[51px]">{heading.title}</h1>
    <p class="mx-auto mt-4 max-w-[620px] text-[15px] leading-[1.4] text-[#1a2352] md:text-[18px] lg:max-w-[820px]">{heading.sub}</p>
  </div>
</section>

<section class="bg-white">
  <div class="container-c pb-16 pt-8 lg:pb-24 lg:pt-10">
    {interviews.length > 0 ? (
      <ul role="list" class="grid list-none gap-y-10 p-0 grid-cols-1 md:grid-cols-3 md:gap-x-10 md:gap-y-12 lg:gap-x-[60px] lg:gap-y-16">
        {interviews.map((interview) => (
        <li>
          <a href={localizePath(`/blog/${interview.slug}`, lang)} class="group flex flex-col">
            <div class="overflow-hidden rounded-2xl bg-black/5">
              <img src={`/blog/${interview.cover}`} alt={interview.coverAlt || heading.cover(interview.title)} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
            </div>
            <h2 class="font-body mt-4 text-[18px] font-semibold leading-[1.25] text-[#1a2352] lg:text-[20px]">{interview.title}</h2>
            <p class="mt-3 text-[14px] leading-[1.4] text-[#1a2352] md:text-[15px]">{interview.description}</p>
          </a>
        </li>
        ))}
      </ul>
    ) : <p class="py-12 text-center text-[15px] text-[#1a2352]">{heading.empty}</p>}
  </div>
</section>
