---
import CealPage from '../../components/pages/ax-v2/ceal/CealPage.astro';
import type { Crumb } from '../../i18n/breadcrumbs';
import { breadcrumbLd } from '../../i18n/structuredData';
import type { LeadPageContext } from '../../lead/pageContext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_ORIGIN } from '../../site';

const lang = 'ko' as const;
const basePath = '/ax/ceal';
const title = 'Corca AX | Ceal';
const description =
  'AI 비용은 구조적으로 줄이고, 같은 인원으로 더 많은 일을 해내는 AX 환경 구축 솔루션, Ceal';
const breadcrumbs = [
  { name: 'Corca AX', path: '/ax' },
  { name: 'Ceal', path: basePath },
] satisfies Crumb[];
const site = Astro.site ?? new URL(SITE_ORIGIN);
const leadContext = {
  pageId: 'ceal',
  contentType: 'ax-ceal',
  basePath,
} satisfies LeadPageContext;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  basePath={basePath}
  localized={false}
  noindex
  breadcrumbs={breadcrumbs}
  jsonLd={[breadcrumbLd(site, lang, breadcrumbs)]}
>
  <CealPage leadContext={leadContext} />
</BaseLayout>
